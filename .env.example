# =================================================================
# InsightIQ: Environment Configuration Example
# =================================================================

# Backend Database Connection (PostgreSQL in production, SQLite fallback by default)
# DATABASE_URL=postgresql://insightiq_user:insightiq_password@localhost:5432/insightiq
DATABASE_URL=sqlite:///./insightiq.db

# JWT Secret Key for Authentication
SECRET_KEY=insightiq-super-secret-production-jwt-key-2026

# AI / LLM API Key (Optional: Google Gemini or OpenAI API Key)
# If left empty, InsightIQ automatically uses its robust built-in Pandas Natural Language Analysis Engine!
AI_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
