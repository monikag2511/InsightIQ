# =================================================================
# Ask Your Data: Environment Configuration Example
# =================================================================

# Backend Database Connection (PostgreSQL in production, SQLite fallback by default)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/askyourdata
DATABASE_URL=sqlite:///./insightiq.db

# JWT Secret Key for Authentication
SECRET_KEY=askyourdata-super-secret-production-jwt-key-2026

# Groq AI API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative / Fallback AI API Key (Optional)
# AI_API_KEY=

# Note: If no AI key is configured, Ask Your Data operates seamlessly in
# high-speed Built-in Deterministic Analysis Engine Mode!

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
